#pragma once

// Copy this file to secrets.h (same folder) and fill in your network.
// secrets.h is listed in .gitignore so your password never gets committed.
// Without it the firmware still builds: it skips the default network and uses
// credentials saved from the web page, or starts its setup access point.

#define DEFAULT_STA_SSID          "your_wifi_name"
#define DEFAULT_STA_PASSWORD      "your_wifi_password"
